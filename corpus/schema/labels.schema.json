{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ppcdaniel/sarif-regress/corpus/schema/labels.schema.json",
  "title": "SarifRegress corpus labels",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pairs",
    "expectedAmbiguous"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "baselineKey",
          "candidateKey",
          "classification"
        ],
        "properties": {
          "baselineKey": {
            "type": "string",
            "minLength": 1
          },
          "candidateKey": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "unchanged",
              "moved",
              "modified"
            ]
          }
        }
      }
    },
    "expectedAmbiguous": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expectedResolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "expectedNew": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "default": []
    },
    "expectedInvalidInputs": {
      "type": "array",
      "items": {
        "enum": [
          "baseline",
          "candidate"
        ]
      },
      "uniqueItems": true,
      "default": []
    }
  }
}
