{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ppcdaniel/sarif-regress/validation/schemas/v2-to-v3-delta.schema.json",
  "title": "SarifRegress matcher-v2 to matcher-v3 holdout delta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportKind",
    "inputHashes",
    "matcherV2",
    "matcherV3",
    "algorithmVersionChanges",
    "cases",
    "relationships",
    "newlyIntroducedFalseMatches",
    "ambiguityChanges",
    "ingestionSuccessChanges",
    "remainingFailures",
    "changedDecisionCount",
    "changedDecisionTraceCount",
    "changedDecisionWithoutTraceCount",
    "changedDecisionsWithoutTrace",
    "everyChangedDecisionHasTrace"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "reportKind": {
      "const": "matcher-v2-to-v3-delta"
    },
    "inputHashes": {
      "$ref": "#/$defs/inputHashes"
    },
    "matcherV2": {
      "$ref": "#/$defs/matcherV2Snapshot"
    },
    "matcherV3": {
      "$ref": "#/$defs/matcherV3Snapshot"
    },
    "algorithmVersionChanges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/algorithmVersionChange"
      }
    },
    "cases": {
      "$ref": "#/$defs/caseDelta"
    },
    "relationships": {
      "$ref": "#/$defs/relationshipDelta"
    },
    "newlyIntroducedFalseMatches": {
      "$ref": "#/$defs/relationshipReferences"
    },
    "ambiguityChanges": {
      "$ref": "#/$defs/ambiguityDelta"
    },
    "ingestionSuccessChanges": {
      "$ref": "#/$defs/ingestionDelta"
    },
    "remainingFailures": {
      "$ref": "#/$defs/relationshipReferences"
    },
    "changedDecisionCount": {
      "$ref": "#/$defs/count"
    },
    "changedDecisionTraceCount": {
      "$ref": "#/$defs/count"
    },
    "changedDecisionWithoutTraceCount": {
      "$ref": "#/$defs/count"
    },
    "changedDecisionsWithoutTrace": {
      "$ref": "#/$defs/relationshipReferences"
    },
    "everyChangedDecisionHasTrace": {
      "type": "boolean"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![vV]?[lL][aA][tT][eE][sS][tT]$)(?!.*[ *xX^~><=|])[0-9A-Za-z][0-9A-Za-z._+-]*$"
    },
    "algorithmVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+/-]*$"
    },
    "schemaVersionValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[0-9]+(?:\\.[0-9]+)*$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "inputHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matcherV2HistoryChecksumManifestSha256",
        "matcherV2ReportSha256",
        "matcherV3ReportSha256",
        "holdoutManifestSha256"
      ],
      "properties": {
        "matcherV2HistoryChecksumManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "matcherV2ReportSha256": {
          "$ref": "#/$defs/sha256"
        },
        "matcherV3ReportSha256": {
          "$ref": "#/$defs/sha256"
        },
        "holdoutManifestSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "namedAlgorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/algorithmVersion"
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryCommitSha",
        "sourceTreeSha256",
        "sarifRegressToolVersion",
        "matcherAlgorithmVersion",
        "fingerprintAlgorithmVersions",
        "outputSchemaVersion",
        "configurationSchemaVersion",
        "holdoutManifestSha256"
      ],
      "properties": {
        "repositoryCommitSha": {
          "$ref": "#/$defs/gitCommitSha"
        },
        "sourceTreeSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sarifRegressToolVersion": {
          "$ref": "#/$defs/version"
        },
        "matcherAlgorithmVersion": {
          "$ref": "#/$defs/algorithmVersion"
        },
        "fingerprintAlgorithmVersions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/namedAlgorithm"
          }
        },
        "outputSchemaVersion": {
          "$ref": "#/$defs/schemaVersionValue"
        },
        "configurationSchemaVersion": {
          "$ref": "#/$defs/schemaVersionValue"
        },
        "holdoutManifestSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "groundTruthUnits",
        "labelledRelationships",
        "labelledMatches",
        "truePositives",
        "falsePositives",
        "falseNegatives",
        "classificationMismatches",
        "expectedNewClassifications",
        "newClassifications",
        "correctNewClassifications",
        "incorrectNewClassifications",
        "newClassificationAccuracy",
        "expectedResolvedClassifications",
        "resolvedClassifications",
        "correctResolvedClassifications",
        "incorrectResolvedClassifications",
        "resolvedClassificationAccuracy",
        "ambiguousClassifications",
        "correctAmbiguityRefusals",
        "unexpectedAmbiguityRefusals",
        "incorrectlyAutoMatchedAmbiguousCases",
        "ingestionFailures",
        "structuralFailures",
        "precision",
        "recall",
        "f1"
      ],
      "properties": {
        "groundTruthUnits": { "$ref": "#/$defs/count" },
        "labelledRelationships": { "$ref": "#/$defs/count" },
        "labelledMatches": { "$ref": "#/$defs/count" },
        "truePositives": { "$ref": "#/$defs/count" },
        "falsePositives": { "$ref": "#/$defs/count" },
        "falseNegatives": { "$ref": "#/$defs/count" },
        "classificationMismatches": { "$ref": "#/$defs/count" },
        "expectedNewClassifications": { "$ref": "#/$defs/count" },
        "newClassifications": { "$ref": "#/$defs/count" },
        "correctNewClassifications": { "$ref": "#/$defs/count" },
        "incorrectNewClassifications": { "$ref": "#/$defs/count" },
        "newClassificationAccuracy": { "$ref": "#/$defs/ratio" },
        "expectedResolvedClassifications": { "$ref": "#/$defs/count" },
        "resolvedClassifications": { "$ref": "#/$defs/count" },
        "correctResolvedClassifications": { "$ref": "#/$defs/count" },
        "incorrectResolvedClassifications": { "$ref": "#/$defs/count" },
        "resolvedClassificationAccuracy": { "$ref": "#/$defs/ratio" },
        "ambiguousClassifications": { "$ref": "#/$defs/count" },
        "correctAmbiguityRefusals": { "$ref": "#/$defs/count" },
        "unexpectedAmbiguityRefusals": { "$ref": "#/$defs/count" },
        "incorrectlyAutoMatchedAmbiguousCases": { "$ref": "#/$defs/count" },
        "ingestionFailures": { "$ref": "#/$defs/count" },
        "structuralFailures": { "$ref": "#/$defs/count" },
        "precision": { "$ref": "#/$defs/ratio" },
        "recall": { "$ref": "#/$defs/ratio" },
        "f1": { "$ref": "#/$defs/ratio" }
      }
    },
    "producerMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producerId",
        "metrics"
      ],
      "properties": {
        "producerId": {
          "$ref": "#/$defs/identifier"
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation",
        "aggregate",
        "producers"
      ],
      "properties": {
        "evaluation": {
          "$ref": "#/$defs/evaluation"
        },
        "aggregate": {
          "$ref": "#/$defs/metrics"
        },
        "producers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/producerMetrics"
          }
        }
      }
    },
    "matcherV2Snapshot": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        {
          "properties": {
            "evaluation": {
              "properties": {
                "matcherAlgorithmVersion": {
                  "const": "sarifregress/matcher/v2"
                }
              }
            }
          }
        }
      ]
    },
    "matcherV3Snapshot": {
      "allOf": [
        { "$ref": "#/$defs/snapshot" },
        {
          "properties": {
            "evaluation": {
              "properties": {
                "matcherAlgorithmVersion": {
                  "const": "sarifregress/matcher/v3"
                }
              }
            }
          }
        }
      ]
    },
    "algorithmVersionChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "matcherV2Version",
        "matcherV3Version",
        "changed"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "matcherV2Version": {
          "oneOf": [
            { "$ref": "#/$defs/algorithmVersion" },
            { "type": "null" }
          ]
        },
        "matcherV3Version": {
          "oneOf": [
            { "$ref": "#/$defs/algorithmVersion" },
            { "type": "null" }
          ]
        },
        "changed": {
          "type": "boolean"
        }
      }
    },
    "caseReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "producerId"
      ],
      "properties": {
        "caseId": { "$ref": "#/$defs/identifier" },
        "producerId": { "$ref": "#/$defs/identifier" }
      }
    },
    "caseReferences": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/caseReference" }
    },
    "outcome": {
      "enum": [
        "true-positive",
        "false-match",
        "missed-match",
        "classification-mismatch",
        "correct-new",
        "incorrect-new",
        "correct-resolved",
        "incorrect-resolved",
        "correct-ambiguity-refusal",
        "unexpected-ambiguity-refusal",
        "incorrect-ambiguity-match",
        "ingestion-failure",
        "structural-failure"
      ]
    },
    "relationshipReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "producerId",
        "relationshipId",
        "matcherV2Outcome",
        "matcherV3Outcome"
      ],
      "properties": {
        "caseId": { "$ref": "#/$defs/identifier" },
        "producerId": { "$ref": "#/$defs/identifier" },
        "relationshipId": { "$ref": "#/$defs/identifier" },
        "matcherV2Outcome": { "$ref": "#/$defs/outcome" },
        "matcherV3Outcome": { "$ref": "#/$defs/outcome" }
      }
    },
    "relationshipReferences": {
      "type": "array",
      "maxItems": 1000000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relationshipReference" }
    },
    "caseDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed",
        "regressed",
        "stillFailing"
      ],
      "properties": {
        "fixed": { "$ref": "#/$defs/caseReferences" },
        "regressed": { "$ref": "#/$defs/caseReferences" },
        "stillFailing": { "$ref": "#/$defs/caseReferences" }
      }
    },
    "relationshipDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed",
        "regressed",
        "stillFailing"
      ],
      "properties": {
        "fixed": { "$ref": "#/$defs/relationshipReferences" },
        "regressed": { "$ref": "#/$defs/relationshipReferences" },
        "stillFailing": { "$ref": "#/$defs/relationshipReferences" }
      }
    },
    "ambiguityDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matcherV2CorrectRefusals",
        "matcherV3CorrectRefusals",
        "matcherV2UnexpectedRefusals",
        "matcherV3UnexpectedRefusals",
        "matcherV2IncorrectAutoMatches",
        "matcherV3IncorrectAutoMatches",
        "fixed",
        "regressed",
        "stillFailing",
        "unexpectedRefusalsResolved",
        "unexpectedRefusalsIntroduced"
      ],
      "properties": {
        "matcherV2CorrectRefusals": { "$ref": "#/$defs/count" },
        "matcherV3CorrectRefusals": { "$ref": "#/$defs/count" },
        "matcherV2UnexpectedRefusals": { "$ref": "#/$defs/count" },
        "matcherV3UnexpectedRefusals": { "$ref": "#/$defs/count" },
        "matcherV2IncorrectAutoMatches": { "$ref": "#/$defs/count" },
        "matcherV3IncorrectAutoMatches": { "$ref": "#/$defs/count" },
        "fixed": { "$ref": "#/$defs/relationshipReferences" },
        "regressed": { "$ref": "#/$defs/relationshipReferences" },
        "stillFailing": { "$ref": "#/$defs/relationshipReferences" },
        "unexpectedRefusalsResolved": { "$ref": "#/$defs/relationshipReferences" },
        "unexpectedRefusalsIntroduced": { "$ref": "#/$defs/relationshipReferences" }
      }
    },
    "ingestionDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matcherV2Failures",
        "matcherV3Failures",
        "newlySuccessful",
        "newlyFailed",
        "stillFailing"
      ],
      "properties": {
        "matcherV2Failures": { "$ref": "#/$defs/count" },
        "matcherV3Failures": { "$ref": "#/$defs/count" },
        "newlySuccessful": { "$ref": "#/$defs/caseReferences" },
        "newlyFailed": { "$ref": "#/$defs/caseReferences" },
        "stillFailing": { "$ref": "#/$defs/caseReferences" }
      }
    }
  }
}
