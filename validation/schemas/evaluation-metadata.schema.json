{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ppcdaniel/sarif-regress/validation/schemas/evaluation-metadata.schema.json",
  "title": "SarifRegress holdout evaluation environment metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryCommitSha",
    "sourceTreeSha256",
    "sarifRegressToolVersion",
    "matcherAlgorithmVersion",
    "fingerprintAlgorithmVersions",
    "outputSchemaVersion",
    "configurationSchemaVersion",
    "holdoutManifestSha256",
    "environment"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "repositoryCommitSha": {
      "$ref": "#/$defs/gitCommitSha"
    },
    "sourceTreeSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sarifRegressToolVersion": {
      "$ref": "#/$defs/version"
    },
    "matcherAlgorithmVersion": {
      "$ref": "#/$defs/algorithmVersion"
    },
    "fingerprintAlgorithmVersions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/namedAlgorithm"
      }
    },
    "outputSchemaVersion": {
      "$ref": "#/$defs/schemaVersion"
    },
    "configurationSchemaVersion": {
      "$ref": "#/$defs/schemaVersion"
    },
    "holdoutManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    }
  },
  "$defs": {
    "gitCommitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![vV]?[lL][aA][tT][eE][sS][tT]$)(?!.*[ *xX^~><=|])[0-9A-Za-z][0-9A-Za-z._+-]*$"
    },
    "schemaVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[0-9]+(?:\\.[0-9]+)*$"
    },
    "algorithmVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+/-]*$"
    },
    "namedAlgorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "version": {
          "$ref": "#/$defs/algorithmVersion"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatingSystem",
        "architecture",
        "dotnetSdkVersion"
      ],
      "properties": {
        "operatingSystem": {
          "enum": [
            "linux",
            "windows"
          ]
        },
        "architecture": {
          "enum": [
            "x64",
            "arm64"
          ]
        },
        "dotnetSdkVersion": {
          "$ref": "#/$defs/version"
        }
      }
    }
  }
}
