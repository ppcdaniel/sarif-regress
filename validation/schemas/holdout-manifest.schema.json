{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ppcdaniel/sarif-regress/validation/schemas/holdout-manifest.schema.json",
  "title": "SarifRegress independent holdout manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "holdoutId",
    "producers",
    "cases",
    "counts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "holdoutId": {
      "$ref": "#/$defs/identifier"
    },
    "producers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/producer"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "counts": {
      "$ref": "#/$defs/holdoutCounts"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "exactVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![vV]?[lL][aA][tT][eE][sS][tT]$)(?!.*[ *xX^~><=|])[0-9A-Za-z][0-9A-Za-z._+-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "httpsUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[^\\s]+$"
    },
    "pinnedHttpsUrl": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://(?![^?#]*(?:/latest(?:/|$)|/releases/latest(?:/|$)))[^\\s]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "boundedCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdxIdentifier",
        "name",
        "url"
      ],
      "properties": {
        "spdxIdentifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9.+-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "url": {
          "$ref": "#/$defs/httpsUrl"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workingDirectory",
        "executable",
        "arguments",
        "environment"
      ],
      "properties": {
        "workingDirectory": {
          "$ref": "#/$defs/relativePath"
        },
        "executable": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!\\\\\\\\)[^\\u0000\\r\\n]+$"
        },
        "arguments": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^[^\\u0000\\r\\n]*$"
          }
        },
        "environment": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/environmentVariable"
          }
        }
      }
    },
    "environmentVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "value": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000\\r\\n]*$"
        }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileName",
        "url",
        "sha256",
        "sizeBytes",
        "immutable"
      ],
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "url": {
          "$ref": "#/$defs/pinnedHttpsUrl"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "immutable": {
          "const": true
        }
      }
    },
    "capturePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rulesSource",
        "downloadsRemoteRules",
        "executesFixtureCode",
        "followsSarifNetworkUris"
      ],
      "properties": {
        "rulesSource": {
          "enum": [
            "local-fixture",
            "pinned-built-in"
          ]
        },
        "downloadsRemoteRules": {
          "const": false
        },
        "executesFixtureCode": {
          "const": false
        },
        "followsSarifNetworkUris": {
          "const": false
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "displayName",
        "exactVersion",
        "sourceCommit",
        "projectUrl",
        "releaseUrl",
        "license",
        "captureDate",
        "commands",
        "downloads",
        "capturePolicy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "family": {
          "$ref": "#/$defs/identifier"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000\\r\\n]+$"
        },
        "exactVersion": {
          "$ref": "#/$defs/exactVersion"
        },
        "sourceCommit": {
          "$ref": "#/$defs/gitCommit"
        },
        "projectUrl": {
          "$ref": "#/$defs/httpsUrl"
        },
        "releaseUrl": {
          "$ref": "#/$defs/pinnedHttpsUrl"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "captureDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reproduction",
            "install",
            "capture"
          ],
          "properties": {
            "reproduction": {
              "$ref": "#/$defs/command"
            },
            "install": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/command"
              }
            },
            "capture": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/command"
              }
            }
          }
        },
        "downloads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/download"
          }
        },
        "capturePolicy": {
          "$ref": "#/$defs/capturePolicy"
        }
      }
    },
    "casePaths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directory",
        "baselineSarif",
        "candidateSarif",
        "labels",
        "notes",
        "producerInputDirectory"
      ],
      "properties": {
        "directory": {
          "$ref": "#/$defs/relativePath"
        },
        "baselineSarif": {
          "$ref": "#/$defs/relativePath"
        },
        "candidateSarif": {
          "$ref": "#/$defs/relativePath"
        },
        "labels": {
          "$ref": "#/$defs/relativePath"
        },
        "notes": {
          "$ref": "#/$defs/relativePath"
        },
        "producerInputDirectory": {
          "$ref": "#/$defs/relativePath"
        },
        "config": {
          "oneOf": [
            {
              "$ref": "#/$defs/relativePath"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "caseCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baselineFindings",
        "candidateFindings",
        "groundTruthUnits",
        "labelledRelationships",
        "sameFindingRelationships",
        "newFindings",
        "resolvedFindings",
        "newOrResolvedFindings",
        "ambiguousOrNearCollisionRelationships"
      ],
      "properties": {
        "baselineFindings": {
          "$ref": "#/$defs/boundedCount"
        },
        "candidateFindings": {
          "$ref": "#/$defs/boundedCount"
        },
        "groundTruthUnits": {
          "type": "integer",
          "minimum": 20,
          "maximum": 1000000
        },
        "labelledRelationships": {
          "type": "integer",
          "minimum": 20,
          "maximum": 1000000
        },
        "sameFindingRelationships": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1000000
        },
        "newFindings": {
          "$ref": "#/$defs/boundedCount"
        },
        "resolvedFindings": {
          "$ref": "#/$defs/boundedCount"
        },
        "newOrResolvedFindings": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1000000
        },
        "ambiguousOrNearCollisionRelationships": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "scenario": {
      "enum": [
        "exact-unchanged",
        "inserted-lines",
        "moved-within-file",
        "file-rename",
        "repository-path-rebase",
        "new-finding",
        "resolved-finding",
        "message-change",
        "metadata-change",
        "missing-producer-fingerprint",
        "duplicate-producer-fingerprint",
        "similar-findings-same-file",
        "similar-findings-different-contexts",
        "one-to-many-ambiguity",
        "many-to-one-ambiguity",
        "producer-version-metadata-change",
        "windows-posix-path-projection"
      ]
    },
    "sourceTransformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "script",
        "inputPaths",
        "outputPaths",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "unchanged-copy",
            "insert-lines",
            "move-code",
            "rename-file",
            "rebase-path",
            "add-source-finding",
            "remove-source-finding",
            "change-message-source",
            "change-metadata-source",
            "project-path-style",
            "change-producer-version"
          ]
        },
        "script": {
          "$ref": "#/$defs/relativePath"
        },
        "inputPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "outputPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "description": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "rawSarifMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "originalCapture",
        "script",
        "changedFields",
        "semanticIdentity",
        "rationale"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "originalCapture": {
          "$ref": "#/$defs/relativePath"
        },
        "script": {
          "$ref": "#/$defs/relativePath"
        },
        "changedFields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
          }
        },
        "semanticIdentity": {
          "enum": [
            "preserved",
            "changed"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "inputProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "license",
        "containsRealSecrets",
        "containsProprietaryCode"
      ],
      "properties": {
        "origin": {
          "enum": [
            "created-for-repository",
            "clearly-redistributable"
          ]
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "sourceUrl": {
          "oneOf": [
            {
              "$ref": "#/$defs/httpsUrl"
            },
            {
              "type": "null"
            }
          ]
        },
        "containsRealSecrets": {
          "const": false
        },
        "containsProprietaryCode": {
          "const": false
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "producerId",
        "paths",
        "scenarios",
        "counts",
        "inputProvenance",
        "sourceTransformations",
        "rawSarifMutations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "producerId": {
          "$ref": "#/$defs/identifier"
        },
        "paths": {
          "$ref": "#/$defs/casePaths"
        },
        "scenarios": {
          "type": "array",
          "minItems": 2,
          "maxItems": 17,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scenario"
          }
        },
        "counts": {
          "$ref": "#/$defs/caseCounts"
        },
        "inputProvenance": {
          "$ref": "#/$defs/inputProvenance"
        },
        "sourceTransformations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceTransformation"
          }
        },
        "rawSarifMutations": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rawSarifMutation"
          }
        }
      }
    },
    "holdoutCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producerFamilies",
        "cases",
        "groundTruthUnits",
        "labelledRelationships",
        "sameFindingRelationships",
        "newFindings",
        "resolvedFindings",
        "newOrResolvedFindings",
        "ambiguousOrNearCollisionRelationships"
      ],
      "properties": {
        "producerFamilies": {
          "const": 3
        },
        "cases": {
          "const": 3
        },
        "groundTruthUnits": {
          "type": "integer",
          "minimum": 75,
          "maximum": 1000000
        },
        "labelledRelationships": {
          "type": "integer",
          "minimum": 75,
          "maximum": 1000000
        },
        "sameFindingRelationships": {
          "type": "integer",
          "minimum": 30,
          "maximum": 1000000
        },
        "newFindings": {
          "$ref": "#/$defs/boundedCount"
        },
        "resolvedFindings": {
          "$ref": "#/$defs/boundedCount"
        },
        "newOrResolvedFindings": {
          "type": "integer",
          "minimum": 15,
          "maximum": 1000000
        },
        "ambiguousOrNearCollisionRelationships": {
          "type": "integer",
          "minimum": 3,
          "maximum": 1000000
        }
      }
    }
  }
}
