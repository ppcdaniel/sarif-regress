{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ppcdaniel/sarif-regress/validation/research/sparse-sarif/schemas/experiment-implementation-manifest.schema.json",
  "title": "Sparse experiment implementation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "algorithm", "files"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "kind": { "const": "sparse-experiment-implementation-manifest/v1" },
    "algorithm": { "const": "sha256" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?:Directory\\.Build\\.props|Directory\\.Packages\\.props|global\\.json|(?:src/SarifRegress\\.(?:Cli|Core|Match|Report|Sarif)|validation/tools/SarifRegress\\.Validation)/(?!.*(?:^|/)(?:bin|obj)/)(?:[A-Za-z0-9._-]+/)*(?:[A-Za-z0-9._-]+\\.cs|[A-Za-z0-9._-]+\\.csproj|packages\\.lock\\.json))$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
