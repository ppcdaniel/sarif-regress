{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ppcdaniel/sarif-regress/validation/research/sparse-sarif/schemas/labels.schema.json",
  "title": "Sparse-SARIF independently derived ground truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "familyId",
    "producerFamily",
    "ruleId",
    "baselineSarif",
    "candidateSarif",
    "relationships",
    "new",
    "resolved",
    "ambiguities"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "familyId": {
      "$ref": "#/$defs/stableId"
    },
    "producerFamily": {
      "const": "pmd"
    },
    "ruleId": {
      "const": "AvoidPrintStackTrace"
    },
    "baselineSarif": {
      "$ref": "#/$defs/relativePath"
    },
    "candidateSarif": {
      "$ref": "#/$defs/relativePath"
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "new": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/newFinding"
      }
    },
    "resolved": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/resolvedFinding"
      }
    },
    "ambiguities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/ambiguity"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startLine",
        "startColumn",
        "endLine",
        "endColumn"
      ],
      "properties": {
        "startLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "startColumn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "endLine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "artifactUri",
        "region",
        "message"
      ],
      "properties": {
        "ruleId": {
          "const": "AvoidPrintStackTrace"
        },
        "artifactUri": {
          "$ref": "#/$defs/relativePath"
        },
        "region": {
          "$ref": "#/$defs/region"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "description"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "baselineSourcePath": {
          "$ref": "#/$defs/relativePath"
        },
        "candidateSourcePath": {
          "$ref": "#/$defs/relativePath"
        },
        "baselineFileSha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidateFileSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "dependentRequired": {
        "baselineSourcePath": [
          "baselineFileSha256"
        ],
        "baselineFileSha256": [
          "baselineSourcePath"
        ],
        "candidateSourcePath": [
          "candidateFileSha256"
        ],
        "candidateFileSha256": [
          "candidateSourcePath"
        ]
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expectedClassification",
        "baseline",
        "candidate",
        "sourceTransformation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "expectedClassification": {
          "enum": [
            "unchanged",
            "moved",
            "modified"
          ]
        },
        "baseline": {
          "$ref": "#/$defs/selector"
        },
        "candidate": {
          "$ref": "#/$defs/selector"
        },
        "sourceTransformation": {
          "allOf": [
            {
              "$ref": "#/$defs/proof"
            },
            {
              "required": [
                "baselineSourcePath",
                "baselineFileSha256",
                "candidateSourcePath",
                "candidateFileSha256"
              ]
            }
          ]
        }
      }
    },
    "newFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expectedClassification",
        "candidate",
        "sourceTransformation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "expectedClassification": {
          "const": "new"
        },
        "candidate": {
          "$ref": "#/$defs/selector"
        },
        "sourceTransformation": {
          "allOf": [
            {
              "$ref": "#/$defs/proof"
            },
            {
              "required": [
                "candidateSourcePath",
                "candidateFileSha256"
              ]
            }
          ]
        }
      }
    },
    "resolvedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expectedClassification",
        "baseline",
        "sourceTransformation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "expectedClassification": {
          "const": "resolved"
        },
        "baseline": {
          "$ref": "#/$defs/selector"
        },
        "sourceTransformation": {
          "allOf": [
            {
              "$ref": "#/$defs/proof"
            },
            {
              "required": [
                "baselineSourcePath",
                "baselineFileSha256"
              ]
            }
          ]
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "shape",
        "baseline",
        "candidate",
        "expected",
        "sourceTransformation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "shape": {
          "enum": [
            "one-to-many",
            "many-to-one",
            "many-to-many"
          ]
        },
        "baseline": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/selector"
          }
        },
        "candidate": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/selector"
          }
        },
        "expected": {
          "const": "refuse"
        },
        "sourceTransformation": {
          "allOf": [
            {
              "$ref": "#/$defs/proof"
            },
            {
              "required": [
                "baselineSourcePath",
                "baselineFileSha256",
                "candidateSourcePath",
                "candidateFileSha256"
              ]
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "shape": {
                "const": "one-to-many"
              }
            },
            "required": [
              "shape"
            ]
          },
          "then": {
            "properties": {
              "baseline": {
                "maxItems": 1
              },
              "candidate": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "many-to-one"
              }
            },
            "required": [
              "shape"
            ]
          },
          "then": {
            "properties": {
              "baseline": {
                "minItems": 2
              },
              "candidate": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "shape": {
                "const": "many-to-many"
              }
            },
            "required": [
              "shape"
            ]
          },
          "then": {
            "properties": {
              "baseline": {
                "minItems": 2
              },
              "candidate": {
                "minItems": 2
              }
            }
          }
        }
      ]
    }
  }
}
