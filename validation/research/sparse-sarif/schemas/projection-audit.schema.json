{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ppcdaniel/sarif-regress/validation/research/sparse-sarif/schemas/projection-audit.schema.json",
  "title": "Sparse-SARIF PMD projection audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "algorithmVersion",
    "captureContractSha256",
    "familyId",
    "side",
    "logicalSourceRoot",
    "rawSarif",
    "projectedSarif",
    "changes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "algorithmVersion": {
      "const": "pmd-file-uri-prefix-projection/v1"
    },
    "captureContractSha256": {
      "$ref": "#/$defs/sha256"
    },
    "familyId": {
      "$ref": "#/$defs/stableId"
    },
    "side": {
      "enum": [
        "baseline",
        "candidate"
      ]
    },
    "logicalSourceRoot": {
      "$ref": "#/$defs/relativePath"
    },
    "rawSarif": {
      "$ref": "#/$defs/fileEvidence"
    },
    "projectedSarif": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256",
        "resultCount"
      ],
      "properties": {
        "bytes": {
          "$ref": "#/$defs/byteCount"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resultCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/change"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "byteCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "fileEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256"
      ],
      "properties": {
        "bytes": {
          "$ref": "#/$defs/byteCount"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pointer",
        "originalValueSha256",
        "projectedValue"
      ],
      "properties": {
        "kind": {
          "const": "checkout-file-uri-prefix-removal"
        },
        "pointer": {
          "type": "string",
          "pattern": "^/runs/0/results/(?:0|[1-9][0-9]*)/locations/0/physicalLocation/artifactLocation/uri$"
        },
        "originalValueSha256": {
          "$ref": "#/$defs/sha256"
        },
        "projectedValue": {
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  }
}
