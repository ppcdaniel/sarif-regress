{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ppcdaniel/sarif-regress/validation/research/sparse-sarif/schemas/experiment-supporting-evidence.schema.json",
  "title": "Typed sparse-experiment supporting evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "corpusManifestSha256", "implementationManifestSha256", "workflow", "projectionPath", "projectionSha256", "variants"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "kind": {
      "enum": [
        "sparse-experiment-release-evidence/v1",
        "sparse-experiment-determinism-evidence/v1",
        "sparse-experiment-resource-evidence/v1"
      ]
    },
    "corpusManifestSha256": { "$ref": "#/$defs/sha256" },
    "implementationManifestSha256": { "$ref": "#/$defs/sha256" },
    "workflow": { "$ref": "#/$defs/workflow" },
    "projectionPath": {
      "allOf": [{ "$ref": "#/$defs/relativePath" }],
      "description": "Coordinator-produced typed projection containing this role's exact admitted corpus, implementation, and ordered variant values."
    },
    "projectionSha256": {
      "allOf": [{ "$ref": "#/$defs/sha256" }],
      "description": "SHA-256 of the exact coordinator projection bytes."
    },
    "variants": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/variant" }, { "properties": { "id": { "const": "sarif-only-control" } } }] },
        { "allOf": [{ "$ref": "#/$defs/variant" }, { "properties": { "id": { "const": "exact-region-snippet" } } }] },
        { "allOf": [{ "$ref": "#/$defs/variant" }, { "properties": { "id": { "const": "token-window" } } }] },
        { "allOf": [{ "$ref": "#/$defs/variant" }, { "properties": { "id": { "const": "relative-context" } } }] },
        { "allOf": [{ "$ref": "#/$defs/variant" }, { "properties": { "id": { "const": "agreement-only-combination" } } }] }
      ],
      "items": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "sparse-experiment-release-evidence/v1" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "workflow": { "$ref": "#/$defs/releaseWorkflow" },
          "variants": { "contains": { "required": ["value"], "properties": { "value": { "$ref": "#/$defs/releaseEvidence" } } }, "minContains": 5 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "sparse-experiment-determinism-evidence/v1" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "workflow": { "$ref": "#/$defs/determinismWorkflow" },
          "variants": { "contains": { "required": ["value"], "properties": { "value": { "$ref": "#/$defs/determinismEvidence" } } }, "minContains": 5 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "sparse-experiment-resource-evidence/v1" } }, "required": ["kind"] },
      "then": {
        "properties": {
          "workflow": { "$ref": "#/$defs/resourceWorkflow" },
          "variants": { "contains": { "required": ["value"], "properties": { "value": { "$ref": "#/$defs/resourceEvidence" } } }, "minContains": 5 }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "count": { "type": "integer", "minimum": 0, "maximum": 10000000 },
    "rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "sourceHeadSha", "artifacts"],
      "properties": {
        "runId": { "type": "integer", "minimum": 1 },
        "sourceHeadSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 13,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/workflowArtifact" }
        }
      }
    },
    "workflowArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "digest"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "id": { "type": "integer", "minimum": 1 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "releaseWorkflow": {
      "allOf": [
        { "$ref": "#/$defs/workflow" },
        {
          "properties": {
            "artifacts": {
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                { "properties": { "name": { "const": "holdout-linux" } } },
                { "properties": { "name": { "const": "holdout-windows" } } },
                { "properties": { "name": { "const": "holdout-cross-platform" } } }
              ],
              "items": false
            }
          }
        }
      ]
    },
    "determinismWorkflow": {
      "allOf": [
        { "$ref": "#/$defs/workflow" },
        {
          "properties": {
            "artifacts": {
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                { "properties": { "name": { "const": "determinism-linux" } } },
                { "properties": { "name": { "const": "determinism-windows" } } },
                { "properties": { "name": { "const": "cross-platform-determinism" } } }
              ],
              "items": false
            }
          }
        }
      ]
    },
    "resourceWorkflow": {
      "allOf": [
        { "$ref": "#/$defs/workflow" },
        {
          "properties": {
            "artifacts": {
              "minItems": 13,
              "maxItems": 13,
              "prefixItems": [
                { "properties": { "name": { "const": "benchmark-1000-unique-linux" } } },
                { "properties": { "name": { "const": "benchmark-1000-unique-windows" } } },
                { "properties": { "name": { "const": "benchmark-1000-pathological-linux" } } },
                { "properties": { "name": { "const": "benchmark-1000-pathological-windows" } } },
                { "properties": { "name": { "const": "benchmark-10000-unique-linux" } } },
                { "properties": { "name": { "const": "benchmark-10000-unique-windows" } } },
                { "properties": { "name": { "const": "benchmark-10000-pathological-linux" } } },
                { "properties": { "name": { "const": "benchmark-10000-pathological-windows" } } },
                { "properties": { "name": { "const": "benchmark-100000-unique-linux" } } },
                { "properties": { "name": { "const": "benchmark-100000-unique-windows" } } },
                { "properties": { "name": { "const": "benchmark-100000-pathological-linux" } } },
                { "properties": { "name": { "const": "benchmark-100000-pathological-windows" } } },
                { "properties": { "name": { "const": "benchmark-cross-platform" } } }
              ],
              "items": false
            }
          }
        }
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value"],
      "properties": {
        "id": {
          "enum": ["sarif-only-control", "exact-region-snippet", "token-window", "relative-context", "agreement-only-combination"]
        },
        "value": { "type": "object" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedPairs", "truePositives", "falsePositives", "falseNegatives", "precision", "recall", "f1"],
      "properties": {
        "acceptedPairs": { "$ref": "#/$defs/count" },
        "truePositives": { "$ref": "#/$defs/count" },
        "falsePositives": { "$ref": "#/$defs/count" },
        "falseNegatives": { "$ref": "#/$defs/count" },
        "precision": { "$ref": "#/$defs/rate" },
        "recall": { "$ref": "#/$defs/rate" },
        "f1": { "$ref": "#/$defs/rate" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producerFamily", "metrics", "regressions"],
      "properties": {
        "producerFamily": { "enum": ["semgrep", "gitleaks", "pmd"] },
        "metrics": { "$ref": "#/$defs/metrics" },
        "regressions": { "$ref": "#/$defs/count" }
      }
    },
    "holdout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationshipCount", "metrics", "byProducer", "ingestionFailures", "structuralFailures"],
      "properties": {
        "relationshipCount": { "const": 75 },
        "metrics": { "$ref": "#/$defs/metrics" },
        "byProducer": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/producer" }, { "properties": { "producerFamily": { "const": "semgrep" } } }] },
            { "allOf": [{ "$ref": "#/$defs/producer" }, { "properties": { "producerFamily": { "const": "gitleaks" } } }] },
            { "allOf": [{ "$ref": "#/$defs/producer" }, { "properties": { "producerFamily": { "const": "pmd" } } }] }
          ],
          "items": false
        },
        "ingestionFailures": { "$ref": "#/$defs/count" },
        "structuralFailures": { "$ref": "#/$defs/count" },
        "reportPath": { "$ref": "#/$defs/relativePath" },
        "reportSha256": { "$ref": "#/$defs/sha256" }
      },
      "dependentRequired": {
        "reportPath": ["reportSha256"],
        "reportSha256": ["reportPath"]
      }
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "regressions", "silentlyMatchedAmbiguity"],
      "properties": {
        "passed": { "type": "boolean" },
        "regressions": { "$ref": "#/$defs/count" },
        "silentlyMatchedAmbiguity": { "$ref": "#/$defs/count" },
        "reportPath": { "$ref": "#/$defs/relativePath" },
        "reportSha256": { "$ref": "#/$defs/sha256" }
      },
      "dependentRequired": {
        "reportPath": ["reportSha256"],
        "reportSha256": ["reportPath"]
      }
    },
    "releaseEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holdout", "developmentCorpus"],
      "properties": {
        "holdout": { "$ref": "#/$defs/holdout" },
        "developmentCorpus": { "$ref": "#/$defs/development" }
      }
    },
    "artifactReference": {
      "type": "object",
      "required": ["firstOutputSha256", "secondOutputSha256"],
      "properties": {
        "firstOutputSha256": { "$ref": "#/$defs/sha256" },
        "secondOutputSha256": { "$ref": "#/$defs/sha256" },
        "artifactPath": { "$ref": "#/$defs/relativePath" },
        "artifactSha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false,
      "dependentRequired": {
        "artifactPath": ["artifactSha256"],
        "artifactSha256": ["artifactPath"]
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byteIdentical"],
      "properties": {
        "byteIdentical": { "type": "boolean" },
        "artifactPath": { "$ref": "#/$defs/relativePath" },
        "artifactSha256": { "$ref": "#/$defs/sha256" }
      },
      "dependentRequired": {
        "artifactPath": ["artifactSha256"],
        "artifactSha256": ["artifactPath"]
      }
    },
    "determinismEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeatedRunByteIdentical", "linuxWindowsByteIdentical", "linux", "windows", "comparison"],
      "properties": {
        "repeatedRunByteIdentical": { "type": "boolean" },
        "linuxWindowsByteIdentical": { "type": "boolean" },
        "linux": { "$ref": "#/$defs/artifactReference" },
        "windows": { "$ref": "#/$defs/artifactReference" },
        "comparison": { "$ref": "#/$defs/comparison" }
      }
    },
    "resourceCell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operatingSystem", "findingCount", "dataset", "candidateEdges", "maximumComponentSize", "elapsedMilliseconds", "peakWorkingSetBytes", "configuredCandidatePairLimit", "configuredAssignmentComponentLimit", "boundedRefusalObserved", "runtimeBudgetEnforced", "withinDocumentedLimits"],
      "properties": {
        "operatingSystem": { "enum": ["ubuntu", "windows"] },
        "findingCount": { "enum": [1000, 10000, 100000] },
        "dataset": { "enum": ["unique", "pathological"] },
        "candidateEdges": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "maximumComponentSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12,
          "description": "Largest component admitted to bounded assignment; zero when an oversized component is refused before assignment."
        },
        "elapsedMilliseconds": { "type": "integer", "minimum": 0 },
        "peakWorkingSetBytes": { "type": "integer", "minimum": 0 },
        "configuredCandidatePairLimit": { "const": 1000000 },
        "configuredAssignmentComponentLimit": { "const": 12 },
        "boundedRefusalObserved": { "type": "boolean" },
        "runtimeBudgetEnforced": { "type": "boolean" },
        "withinDocumentedLimits": { "type": "boolean" },
        "artifactPath": { "$ref": "#/$defs/relativePath" },
        "artifactSha256": { "$ref": "#/$defs/sha256" }
      },
      "dependentRequired": {
        "artifactPath": ["artifactSha256"],
        "artifactSha256": ["artifactPath"]
      }
    },
    "resourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["withinDocumentedLimits", "sourceContextProjectionBenchmarked", "cells"],
      "properties": {
        "withinDocumentedLimits": { "type": "boolean" },
        "sourceContextProjectionBenchmarked": { "type": "boolean" },
        "cells": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resourceCell" }
        },
        "evidencePath": { "$ref": "#/$defs/relativePath" },
        "evidenceSha256": { "$ref": "#/$defs/sha256" }
      },
      "dependentRequired": {
        "evidencePath": ["evidenceSha256"],
        "evidenceSha256": ["evidencePath"]
      }
    }
  }
}
