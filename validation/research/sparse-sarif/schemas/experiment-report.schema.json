{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ppcdaniel/sarif-regress/validation/research/sparse-sarif/schemas/experiment-report.schema.json",
  "title": "Sparse-SARIF repository-context experiment report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "corpusManifestSha256",
    "evidence",
    "implementation",
    "fixedGates",
    "variants",
    "selectedVariant",
    "decision",
    "reasons"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2"
    },
    "corpusManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observations",
        "gates",
        "release",
        "determinism",
        "resources"
      ],
      "properties": {
        "observations": {
          "allOf": [
            { "$ref": "#/$defs/typedEvidenceReference" },
            { "properties": { "kind": { "const": "sparse-experiment-observations/v1" } } }
          ]
        },
        "gates": {
          "allOf": [
            { "$ref": "#/$defs/typedEvidenceReference" },
            { "properties": { "kind": { "const": "sparse-experiment-gates/v1" } } }
          ]
        },
        "release": {
          "allOf": [
            { "$ref": "#/$defs/typedEvidenceReference" },
            { "properties": { "kind": { "const": "sparse-experiment-release-evidence/v1" } } }
          ]
        },
        "determinism": {
          "allOf": [
            { "$ref": "#/$defs/typedEvidenceReference" },
            { "properties": { "kind": { "const": "sparse-experiment-determinism-evidence/v1" } } }
          ]
        },
        "resources": {
          "allOf": [
            { "$ref": "#/$defs/typedEvidenceReference" },
            { "properties": { "kind": { "const": "sparse-experiment-resource-evidence/v1" } } }
          ]
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "manifestPath",
        "manifestSha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "manifestPath": {
          "const": "experiment-implementation-manifest.json"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "fixedGates": {
      "$ref": "#/$defs/fixedGates"
    },
    "variants": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/variant"
            },
            {
              "properties": {
                "id": {
                  "const": "sarif-only-control"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/variant"
            },
            {
              "properties": {
                "id": {
                  "const": "exact-region-snippet"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/variant"
            },
            {
              "properties": {
                "id": {
                  "const": "token-window"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/variant"
            },
            {
              "properties": {
                "id": {
                  "const": "relative-context"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/variant"
            },
            {
              "properties": {
                "id": {
                  "const": "agreement-only-combination"
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "selectedVariant": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "decision": {
      "enum": [
        "implement-v4",
        "document-limitation"
      ]
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "implement-v4"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "selectedVariant": {
            "type": "string"
          },
          "variants": {
            "contains": {
              "type": "object",
              "required": [
                "gateProjection"
              ],
              "properties": {
                "gateProjection": {
                  "type": "object",
                  "required": [
                    "pmdPrecision",
                    "pmdRecall",
                    "aggregatePrecision",
                    "aggregateRecall",
                    "classificationMismatches",
                    "missedNew",
                    "incorrectNew",
                    "missedResolved",
                    "incorrectResolved",
                    "silentlyMatchedAmbiguity",
                    "sourceSideLeakage",
                    "containmentRegressions",
                    "rootConfusions",
                    "unexplainedIngestionFailures",
                    "structuralFailures",
                    "developmentCorpusGreen",
                    "semgrepNoRegression",
                    "gitleaksNoRegression",
                    "repeatedRunByteIdentical",
                    "crossPlatformByteIdentical",
                    "resourceBudgetsWithinLimits",
                    "scenarioMatrixPassed",
                    "corpusSpecificPreflightRequired"
                  ],
                  "properties": {
                    "pmdPrecision": {
                      "minimum": 0.95
                    },
                    "pmdRecall": {
                      "minimum": 0.8
                    },
                    "aggregatePrecision": {
                      "minimum": 0.95
                    },
                    "aggregateRecall": {
                      "minimum": 0.9
                    },
                    "classificationMismatches": {
                      "const": 0
                    },
                    "missedNew": {
                      "const": 0
                    },
                    "incorrectNew": {
                      "const": 0
                    },
                    "missedResolved": {
                      "const": 0
                    },
                    "incorrectResolved": {
                      "const": 0
                    },
                    "silentlyMatchedAmbiguity": {
                      "const": 0
                    },
                    "sourceSideLeakage": {
                      "const": 0
                    },
                    "containmentRegressions": {
                      "const": 0
                    },
                    "rootConfusions": {
                      "const": 0
                    },
                    "unexplainedIngestionFailures": {
                      "const": 0
                    },
                    "structuralFailures": {
                      "const": 0
                    },
                    "developmentCorpusGreen": {
                      "const": true
                    },
                    "semgrepNoRegression": {
                      "const": true
                    },
                    "gitleaksNoRegression": {
                      "const": true
                    },
                    "repeatedRunByteIdentical": {
                      "const": true
                    },
                    "crossPlatformByteIdentical": {
                      "const": true
                    },
                    "resourceBudgetsWithinLimits": {
                      "const": true
                    },
                    "scenarioMatrixPassed": {
                      "const": true
                    },
                    "corpusSpecificPreflightRequired": {
                      "const": false
                    }
                  }
                }
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "document-limitation"
          }
        },
        "required": [
          "decision"
        ]
      },
      "then": {
        "properties": {
          "selectedVariant": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "dependentRequired": {
        "path": [
          "sha256"
        ],
        "sha256": [
          "path"
        ]
      }
    },
    "typedEvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "sha256"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000000
    },
    "fixedGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumPmdPrecision",
        "minimumPmdRecall",
        "minimumAggregatePrecision",
        "minimumAggregateRecall",
        "maximumSilentlyMatchedAmbiguity",
        "maximumSourceSideLeakage",
        "maximumContainmentRegressions",
        "maximumRootConfusions",
        "maximumUnexplainedIngestionFailures",
        "maximumStructuralFailures",
        "maximumClassificationMismatches",
        "maximumMissedNew",
        "maximumIncorrectNew",
        "maximumMissedResolved",
        "maximumIncorrectResolved",
        "requireDevelopmentCorpusGreen",
        "requireExistingProducerNoRegression",
        "requireCrossPlatformByteIdentity",
        "requireResourceBudgets",
        "requireScenarioMatrixGreen",
        "requireCorpusIndependentEvidence"
      ],
      "properties": {
        "minimumPmdPrecision": {
          "const": 0.95
        },
        "minimumPmdRecall": {
          "const": 0.8
        },
        "minimumAggregatePrecision": {
          "const": 0.95
        },
        "minimumAggregateRecall": {
          "const": 0.9
        },
        "maximumSilentlyMatchedAmbiguity": {
          "const": 0
        },
        "maximumSourceSideLeakage": {
          "const": 0
        },
        "maximumContainmentRegressions": {
          "const": 0
        },
        "maximumRootConfusions": {
          "const": 0
        },
        "maximumUnexplainedIngestionFailures": {
          "const": 0
        },
        "maximumStructuralFailures": {
          "const": 0
        },
        "maximumClassificationMismatches": {
          "const": 0
        },
        "maximumMissedNew": {
          "const": 0
        },
        "maximumIncorrectNew": {
          "const": 0
        },
        "maximumMissedResolved": {
          "const": 0
        },
        "maximumIncorrectResolved": {
          "const": 0
        },
        "requireDevelopmentCorpusGreen": {
          "const": true
        },
        "requireExistingProducerNoRegression": {
          "const": true
        },
        "requireCrossPlatformByteIdentity": {
          "const": true
        },
        "requireResourceBudgets": {
          "const": true
        },
        "requireScenarioMatrixGreen": {
          "const": true
        },
        "requireCorpusIndependentEvidence": {
          "const": true
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truePositives",
        "falsePositives",
        "falseNegatives",
        "acceptedPairs",
        "precision",
        "recall",
        "f1"
      ],
      "properties": {
        "truePositives": {
          "$ref": "#/$defs/count"
        },
        "falsePositives": {
          "$ref": "#/$defs/count"
        },
        "falseNegatives": {
          "$ref": "#/$defs/count"
        },
        "acceptedPairs": {
          "$ref": "#/$defs/count"
        },
        "precision": {
          "$ref": "#/$defs/rate"
        },
        "recall": {
          "$ref": "#/$defs/rate"
        },
        "f1": {
          "$ref": "#/$defs/rate"
        }
      }
    },
    "familyMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "familyId",
        "truePositives",
        "falsePositives",
        "falseNegatives",
        "acceptedPairs",
        "precision",
        "recall",
        "f1"
      ],
      "properties": {
        "familyId": {
          "$ref": "#/$defs/stableId"
        },
        "truePositives": {
          "$ref": "#/$defs/count"
        },
        "falsePositives": {
          "$ref": "#/$defs/count"
        },
        "falseNegatives": {
          "$ref": "#/$defs/count"
        },
        "acceptedPairs": {
          "$ref": "#/$defs/count"
        },
        "precision": {
          "$ref": "#/$defs/rate"
        },
        "recall": {
          "$ref": "#/$defs/rate"
        },
        "f1": {
          "$ref": "#/$defs/rate"
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "matchedRelationships",
        "classificationMismatches"
      ],
      "properties": {
        "matchedRelationships": {
          "$ref": "#/$defs/count"
        },
        "classificationMismatches": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedNew",
        "correctNew",
        "incorrectNew",
        "expectedResolved",
        "correctResolved",
        "incorrectResolved"
      ],
      "properties": {
        "expectedNew": { "$ref": "#/$defs/count" },
        "correctNew": { "$ref": "#/$defs/count" },
        "incorrectNew": { "$ref": "#/$defs/count" },
        "expectedResolved": { "$ref": "#/$defs/count" },
        "correctResolved": { "$ref": "#/$defs/count" },
        "incorrectResolved": { "$ref": "#/$defs/count" }
      }
    },
    "gateProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pmdPrecision",
        "pmdRecall",
        "aggregatePrecision",
        "aggregateRecall",
        "classificationMismatches",
        "missedNew",
        "incorrectNew",
        "missedResolved",
        "incorrectResolved",
        "silentlyMatchedAmbiguity",
        "sourceSideLeakage",
        "containmentRegressions",
        "rootConfusions",
        "unexplainedIngestionFailures",
        "structuralFailures",
        "developmentCorpusGreen",
        "semgrepNoRegression",
        "gitleaksNoRegression",
        "repeatedRunByteIdentical",
        "crossPlatformByteIdentical",
        "resourceBudgetsWithinLimits",
        "scenarioMatrixPassed",
        "corpusSpecificPreflightRequired"
      ],
      "properties": {
        "pmdPrecision": {
          "$ref": "#/$defs/rate"
        },
        "pmdRecall": {
          "$ref": "#/$defs/rate"
        },
        "aggregatePrecision": {
          "$ref": "#/$defs/rate"
        },
        "aggregateRecall": {
          "$ref": "#/$defs/rate"
        },
        "classificationMismatches": {
          "$ref": "#/$defs/count"
        },
        "missedNew": {
          "$ref": "#/$defs/count"
        },
        "incorrectNew": {
          "$ref": "#/$defs/count"
        },
        "missedResolved": {
          "$ref": "#/$defs/count"
        },
        "incorrectResolved": {
          "$ref": "#/$defs/count"
        },
        "silentlyMatchedAmbiguity": {
          "$ref": "#/$defs/count"
        },
        "sourceSideLeakage": {
          "$ref": "#/$defs/count"
        },
        "containmentRegressions": {
          "$ref": "#/$defs/count"
        },
        "rootConfusions": {
          "$ref": "#/$defs/count"
        },
        "unexplainedIngestionFailures": {
          "$ref": "#/$defs/count"
        },
        "structuralFailures": {
          "$ref": "#/$defs/count"
        },
        "developmentCorpusGreen": {
          "type": "boolean"
        },
        "semgrepNoRegression": {
          "type": "boolean"
        },
        "gitleaksNoRegression": {
          "type": "boolean"
        },
        "repeatedRunByteIdentical": {
          "type": "boolean"
        },
        "crossPlatformByteIdentical": {
          "type": "boolean"
        },
        "resourceBudgetsWithinLimits": {
          "type": "boolean"
        },
        "scenarioMatrixPassed": {
          "type": "boolean"
        },
        "corpusSpecificPreflightRequired": {
          "type": "boolean"
        }
      }
    },
    "producerEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producerFamily",
        "metrics",
        "regressions"
      ],
      "properties": {
        "producerFamily": {
          "enum": [
            "semgrep",
            "gitleaks",
            "pmd"
          ]
        },
        "metrics": {
          "$ref": "#/$defs/metrics"
        },
        "regressions": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "productionApplicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trustedTreeHashPreflightEnabled",
        "scenariosWithoutTrustedTreeHashes",
        "metricsWithoutTrustedTreeHashes",
        "corpusSpecificPreflightRequired"
      ],
      "properties": {
        "trustedTreeHashPreflightEnabled": {
          "const": false
        },
        "scenariosWithoutTrustedTreeHashes": {
          "$ref": "#/$defs/variant/properties/scenarios"
        },
        "metricsWithoutTrustedTreeHashes": {
          "$ref": "#/$defs/metrics"
        },
        "corpusSpecificPreflightRequired": {
          "type": "boolean"
        },
        "evidencePath": {
          "$ref": "#/$defs/relativePath"
        },
        "evidenceSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "dependentRequired": {
        "evidencePath": [
          "evidenceSha256"
        ],
        "evidenceSha256": [
          "evidencePath"
        ]
      }
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "families"
      ],
      "properties": {
        "scenarioId": {
          "enum": [
            "exact-unchanged-source-location",
            "region-drift-equivalent-token-context",
            "file-method-movement-equivalent-token-context",
            "repeated-context-ambiguity",
            "missing-source-file",
            "mismatched-source-snapshot",
            "baseline-root-bound-to-candidate",
            "candidate-root-bound-to-baseline",
            "both-roots-swapped",
            "same-observation-different-method-file"
          ]
        },
        "families": {
          "$ref": "#/$defs/scenarioFamilyResults"
        }
      }
    },
    "scenarioFamilyResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "familyId",
        "assertionsPassed",
        "preflightAccepted",
        "acceptedRelationships",
        "affectedEndpointMatches",
        "baselineReadsFromCandidateRoot",
        "candidateReadsFromBaselineRoot",
        "containmentViolations",
        "unexplainedIngestionFailures",
        "structuralFailures"
      ],
      "properties": {
        "familyId": {
          "enum": [
            "pmd-clean-a",
            "pmd-clean-b"
          ]
        },
        "assertionsPassed": {
          "type": "boolean"
        },
        "preflightAccepted": {
          "type": "boolean"
        },
        "acceptedRelationships": {
          "$ref": "#/$defs/count"
        },
        "affectedEndpointMatches": {
          "$ref": "#/$defs/count"
        },
        "baselineReadsFromCandidateRoot": {
          "$ref": "#/$defs/count"
        },
        "candidateReadsFromBaselineRoot": {
          "$ref": "#/$defs/count"
        },
        "containmentViolations": {
          "$ref": "#/$defs/count"
        },
        "unexplainedIngestionFailures": {
          "$ref": "#/$defs/count"
        },
        "structuralFailures": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "scenarioFamilyResults": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/scenarioFamilyResult" },
            { "properties": { "familyId": { "const": "pmd-clean-a" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/scenarioFamilyResult" },
            { "properties": { "familyId": { "const": "pmd-clean-b" } } }
          ]
        }
      ],
      "items": false
    },
    "determinismPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstOutputSha256",
        "secondOutputSha256",
        "artifactPath",
        "artifactSha256"
      ],
      "properties": {
        "firstOutputSha256": {
          "$ref": "#/$defs/sha256"
        },
        "secondOutputSha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifactPath": {
          "$ref": "#/$defs/relativePath"
        },
        "artifactSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "dependentRequired": {
        "artifactPath": [
          "artifactSha256"
        ],
        "artifactSha256": [
          "artifactPath"
        ]
      }
    },
    "determinismComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "byteIdentical",
        "artifactPath",
        "artifactSha256"
      ],
      "properties": {
        "byteIdentical": {
          "type": "boolean"
        },
        "artifactPath": {
          "$ref": "#/$defs/relativePath"
        },
        "artifactSha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "dependentRequired": {
        "artifactPath": [
          "artifactSha256"
        ],
        "artifactSha256": [
          "artifactPath"
        ]
      }
    },
    "resourceCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operatingSystem",
        "findingCount",
        "dataset",
        "candidateEdges",
        "maximumComponentSize",
        "elapsedMilliseconds",
        "peakWorkingSetBytes",
        "configuredCandidatePairLimit",
        "configuredAssignmentComponentLimit",
        "boundedRefusalObserved",
        "runtimeBudgetEnforced",
        "withinDocumentedLimits",
        "artifactPath",
        "artifactSha256"
      ],
      "properties": {
        "operatingSystem": {
          "enum": [
            "ubuntu",
            "windows"
          ]
        },
        "findingCount": {
          "enum": [
            1000,
            10000,
            100000
          ]
        },
        "dataset": {
          "enum": [
            "unique",
            "pathological"
          ]
        },
        "candidateEdges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maximumComponentSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12,
          "description": "Largest component admitted to bounded assignment; zero when an oversized component is refused before assignment."
        },
